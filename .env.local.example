# Local development only.
# Copy to .env.local and adjust only local development values.
# Never commit .env.local and never paste production/staging/hosted DB secrets here.

# Local PostgreSQL app database used by the running app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boilabin_local"

# Separate local PostgreSQL shadow database used only by Prisma migrate dev.
# This must not be the same database as DATABASE_URL.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boilabin_shadow"

# Local Auth.js / NextAuth development URLs.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-local-development-secret"
NEXTAUTH_SECRET="replace-with-a-local-development-secret"
AUTH_TRUST_HOST="true"

# Future public SEO canonical domain. This is unrelated to local DB setup.
NEXT_PUBLIC_SITE_URL="https://boilabin.com"

# Local app/API origins for local request guard and browser testing.
APP_URL="http://localhost:3000"
CSRF_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3100"

# Keep online payments disabled until gateway initiation, webhook verification,
# and reconciliation are implemented and approved.
NEXT_PUBLIC_BANGLADESH_ONLINE_PAYMENTS="false"

# Optional Google OAuth values.
# Leave blank until you have a real Google Cloud OAuth client configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional local-only authenticated checkout QA fixture.
# Leave the password blank in committed examples. Set it outside git before
# running npm run auth:buyer:local, and never reuse production/staging secrets.
BOILABIN_LOCAL_BUYER_EMAIL="local-buyer@boilabin.localhost"
BOILABIN_LOCAL_BUYER_PASSWORD=""

# CSP remains disabled by default.
ENABLE_CSP_REPORT_ONLY="false"
ENABLE_CSP_REPORT_COLLECTION="false"
