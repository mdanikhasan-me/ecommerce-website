+import assert from 'node:assert/strict'
+import { describe, it } from 'node:test'
+
+import {
+  buildSearchParams,
+  getImagePlaceholder,
+  slugify,
+  truncate,
+} from '@/backend/utils'
+
+function decodePlaceholder(value: string) {
+  const prefix = 'data:image/svg+xml;charset=utf-8,'
+
+  assert.ok(value.startsWith(prefix))
+  return decodeURIComponent(value.slice(prefix.length))
+}
+
+describe('string utilities', () => {
+  it('slugifies storefront and admin labels into stable URL segments', () => {
+    assert.equal(slugify('  Mobile Phones & Accessories  '), 'mobile-phones-accessories')
+    assert.equal(slugify('Books_Stationery'), 'books-stationery')
+    assert.equal(slugify('Sports---Fitness'), 'sports-fitness')
+    assert.equal(slugify('  !!!  '), '')
+  })
+
+  it('truncates only when text exceeds the requested length', () => {
+    assert.equal(truncate('Boilabin', 20), 'Boilabin')
+    assert.equal(truncate('Boilabin Marketplace', 8), 'Boilabin...')
+    assert.equal(truncate('Boilabin', 0), '...')
+  })
+
+  it('builds search params while dropping undefined and blank values', () => {
+    assert.equal(
+      buildSearchParams({
+        q: 'gaming phone',
+        category: 'electronics',
+        page: 2,
+        sort: '',
+        missing: undefined,
+      }),
+      'q=gaming+phone&category=electronics&page=2',
+    )
+  })
+
+  it('builds search params without dropping zero values', () => {
+    assert.equal(buildSearchParams({ minPrice: 0, maxPrice: 5000 }), 'minPrice=0&maxPrice=5000')
+  })
+
+  it('creates sanitized image placeholder data URLs', () => {
+    const svg = decodePlaceholder(getImagePlaceholder(320.4, 239.5, ' <Missing & Product "Image"> '))
+
+    assert.match(svg, /width="320"/)
+    assert.match(svg, /height="240"/)
+    assert.match(svg, />Missing  Product Image</)
+    assert.doesNotMatch(svg, /<Missing|& Product|"Image"|'/)
+  })
+
+  it('falls back to safe placeholder dimensions and text', () => {
+    const svg = decodePlaceholder(getImagePlaceholder(Number.NaN, -1, '   '))
+
+    assert.match(svg, /width="400"/)
+    assert.match(svg, /height="400"/)
+    assert.match(svg, />No Image</)
+  })
+
+  it('bounds placeholder text length before encoding the SVG', () => {
+    const svg = decodePlaceholder(getImagePlaceholder(100, 100, 'A'.repeat(60)))
+
+    assert.match(svg, new RegExp(`>${'A'.repeat(48)}<`))
+    assert.doesNotMatch(svg, new RegExp(`${'A'.repeat(49)}`))
+  })
+})
