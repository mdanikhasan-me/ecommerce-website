+  if (!trimmed) return null
+  if (!trimmed.startsWith('/') || trimmed.startsWith('//') || trimmed.includes('\\')) return null

   try {
     const url = new URL(trimmed, FALLBACK_ORIGIN)
-    if (url.origin !== FALLBACK_ORIGIN) return fallback
