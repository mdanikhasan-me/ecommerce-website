# Copy this file or .env.local.example to .env.local for local development.
# Never paste production, staging, payment, OAuth, email, or database secrets into this file.

# Local-only Prisma database targets.
# Use a dedicated local app database and a separate local shadow database for prisma migrate dev.
# Do not point these at the same database, and do not use hosted/remote DB URLs for migration work.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boilabin_local"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boilabin_shadow"

# Auth.js / NextAuth local development.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-local-development-secret"
NEXTAUTH_SECRET="replace-with-a-local-development-secret"
# Local development convenience. In hosted production, enable only for a trusted
# reverse proxy/managed host after AUTH_URL/NEXTAUTH_URL point at that host.
AUTH_TRUST_HOST="true"

# Pre-launch public site identity used for SEO canonical URLs.
# The domain does not need to be hosted for local development, but it must point
# to real hosting before public indexing/launch.
NEXT_PUBLIC_SITE_URL="https://boilabin.com"

# Local app/API origins used for local request guards and browser testing.
APP_URL="http://localhost:3000"
# Raw comma-separated origins only. Do not use markdown links or wildcard origins.
CSRF_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3100"

# Optional server-only CSP report-only rollout flag.
# Disabled by default. This must not enable enforced CSP, payment domains, or
# tracking domains. CSP report handling must avoid logging PII or secrets.
ENABLE_CSP_REPORT_ONLY="false"
# Optional server-only CSP report collection flag. Enable only together with
# ENABLE_CSP_REPORT_ONLY during intentional local/staging checks. Do not enable
# in production until logging/storage policy is approved.
ENABLE_CSP_REPORT_COLLECTION="false"

# Optional Google OAuth placeholders for local auth testing.
GOOGLE_CLIENT_ID="local-google-client-id"
GOOGLE_CLIENT_SECRET="local-google-client-secret"

# Keep online payments disabled until gateway initiation, webhook verification,
# and reconciliation are implemented and approved.
NEXT_PUBLIC_BANGLADESH_ONLINE_PAYMENTS="false"
